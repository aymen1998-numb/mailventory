# Gmail over IMAP. Requires 2-step verification on the Google account,
# then an app password: https://myaccount.google.com/apppasswords
# You can also enter these in the app: http://127.0.0.1:8000/settings
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional overrides
# IMAP_SEARCH=UNSEEN
# IMAP_FETCH_LIMIT=20

# Full-mailbox scan (Settings page exposes the same options)
# Empty SYNC_MAILBOX = auto-detect Gmail's All Mail folder
# SYNC_MAILBOX=
# GMAIL_QUERY="has:attachment filename:pdf"
# 0 = no cap
# SYNC_MAX_EMAILS=0

# OCR_ENABLED=false
# DATABASE_URL=sqlite:///./data/orderdesk.db
